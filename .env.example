# The organizer controls these values during official judging.
# Participants may set them locally, but must never commit credentials.
CHALLENGE_PROVIDER=
CHALLENGE_MODEL=
CHALLENGE_THINKING=off
CHALLENGE_TIMEOUT_MS=3600000
CHALLENGE_EXPERIMENT_MAX_EUR=0.25
# Optional integer from 0 to 2. Each repair starts with a fresh context.
CHALLENGE_MAX_REPAIRS=2
# Optional when the shell is running a newer Node major.
CHALLENGE_NODE_BINARY=
